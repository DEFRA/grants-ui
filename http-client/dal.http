### Get Entra ID token

# Retrieves a service-to-service OAuth2 token from Microsoft Entra ID using the client credentials flow.
# The token can then be used as a Bearer token in requests to protected DAL endpoints.
#
# Prerequisites:
#   - Set entraClientId, entraClientSecret and entraTenantId under `test` env in http-client.private.env.json (never commit this file)
#   - Select the `test` environment in your HTTP client
#
# Usage:
#   1. Run this request first to obtain a token (saved to `auth_token`)
#   2. The token is automatically used in requests below via:
#      `Authorization: Bearer {{auth_token}}`
#      email: testuser11 at defra.gov.uk

# @name getEntraToken

POST https://login.microsoftonline.com/{{entraTenantId}}/oauth2/v2.0/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&
client_id={{entraClientId}}&
client_secret={{entraClientSecret}}&
scope={{entraClientId}}/.default

> {%
    client.global.set("auth_token", response.body.access_token);
%}

###

# ─────────────────────────────────────────────
# Business Permissions
# ─────────────────────────────────────────────

@crn = 1102838829
@sbi = 106284736

### Get business permissions for SBI and CRN
# @name getBusinessPermissions

POST {{dalUrl}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{auth_token}}
email: testuser11@defra.gov.uk
#X-Forwarded-Authorization: {{defraIdToken}}

{
  "query": "query GetBusinessPermissions { customer(crn: \"{{crn}}\") { business(sbi: \"{{sbi}}\") { permissionGroups { id level functions } } } }",
  "variables": {
    "crn": "{{crn}}",
    "sbi": "{{sbi}}"
  }
}

### Get business details for SBI
# @name getBusinessDetails

GRAPHQL {{dalUrl}}
Authorization: Bearer {{auth_token}}
email: testuser11@defra.gov.uk
#X-Forwarded-Authorization: {{defraIdToken}}

query GetBusinessDetails($sbi: ID!) {
  business(sbi: $sbi) {
    info {
      name
      reference
      frn
      vat
      traderNumber
      vendorNumber
      address {
        ...FullAddress
      }
      correspondenceAddress {
        ...FullAddress
      }
      isCorrespondenceAsBusinessAddress
      email {
        address
        validated
      }
      correspondenceEmail {
        address
        validated
      }
      phone {
        mobile
        landline
      }
      correspondencePhone {
        mobile
        landline
      }
      legalStatus {
        code
        type
      }
      type {
        code
        type
      }
      registrationNumbers {
        charityCommission
        companiesHouse
      }
      additionalSbis
      lastUpdated
      isFinancialToBusinessAddress
      hasLandInNorthernIreland
      hasLandInScotland
      hasLandInWales
      landConfirmed
      hasAdditionalBusinessActivities
      additionalBusinessActivities {
        code
        type
      }
      isAccountablePeopleDeclarationCompleted
      dateStartedFarming
      status {
        locked
        confirmed
        deactivated
      }
    }
  }
}

fragment FullAddress on Address {
  pafOrganisationName
  line1
  line2
  line3
  line4
  line5
  buildingNumberRange
  buildingName
  flatName
  street
  city
  county
  postalCode
  country
  uprn
  dependentLocality
  doubleDependentLocality
  typeId
}

{
  "sbi": "{{sbi}}"
}

### Search businesses by name
# @name searchBusinesses
# Set searchString to any partial business name (at least 2 characters).
# Increment pagination.page to retrieve further pages.

POST {{dalUrl}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{auth_token}}
email: testuser11@defra.gov.uk
#X-Forwarded-Authorization: {{defraIdToken}}

{
  "query": "query SearchBusinesses($searchString: String!, $pagination: Pagination!) { businessSearch(searchString: $searchString, searchType: BUSINESS_NAME, pagination: $pagination) { results { sbi name } pageInfo { number size totalPages totalElements } } }",
  "variables": {
    "searchString": "farm",
    "pagination": {
      "perPage": 50,
      "page": 1
    }
  }
}
