### DAL requests
# Set dalAccessToken to a valid Entra access token in http-client.private.env.json.
# For local stub requests the token can be left empty.

# ─────────────────────────────────────────────
# Business Permissions
# ─────────────────────────────────────────────

@crn = 9000000001
@sbi = 800000001

### Get business permissions for SBI and CRN
# @name getBusinessPermissions

POST {{dalUrl}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{dalAccessToken}}
email: testuser11@defra.gov.uk
#X-Forwarded-Authorization: {{defraIdToken}}

{
  "query": "query GetBusinessPermissions { customer(crn: \"{{crn}}\") { business(sbi: \"{{sbi}}\") { permissionGroups { id level functions } } } }",
  "variables": {
    "crn": "{{crn}}",
    "sbi": "{{sbi}}"
  }
}

### Get business details for SBI
# @name getBusinessDetails

GRAPHQL {{dalUrl}}
Authorization: Bearer {{dalAccessToken}}
email: testuser11@defra.gov.uk
#X-Forwarded-Authorization: {{defraIdToken}}

query GetBusinessDetails($sbi: ID!) {
  business(sbi: $sbi) {
    info {
      name
      reference
      frn
      vat
      traderNumber
      vendorNumber
      address {
        ...FullAddress
      }
      correspondenceAddress {
        ...FullAddress
      }
      isCorrespondenceAsBusinessAddress
      email {
        address
        validated
      }
      correspondenceEmail {
        address
        validated
      }
      phone {
        mobile
        landline
      }
      correspondencePhone {
        mobile
        landline
      }
      legalStatus {
        code
        type
      }
      type {
        code
        type
      }
      registrationNumbers {
        charityCommission
        companiesHouse
      }
      additionalSbis
      lastUpdated
      isFinancialToBusinessAddress
      hasLandInNorthernIreland
      hasLandInScotland
      hasLandInWales
      landConfirmed
      hasAdditionalBusinessActivities
      additionalBusinessActivities {
        code
        type
      }
      isAccountablePeopleDeclarationCompleted
      dateStartedFarming
      status {
        locked
        confirmed
        deactivated
      }
    }
  }
}

fragment FullAddress on Address {
  pafOrganisationName
  line1
  line2
  line3
  line4
  line5
  buildingNumberRange
  buildingName
  flatName
  street
  city
  county
  postalCode
  country
  uprn
  dependentLocality
  doubleDependentLocality
  typeId
}

{
  "sbi": "{{sbi}}"
}

### Search businesses by name
# @name searchBusinesses
# Set searchString to any partial business name (at least 2 characters).
# Increment pagination.page to retrieve further pages.

POST {{dalUrl}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{dalAccessToken}}
email: testuser11@defra.gov.uk
#X-Forwarded-Authorization: {{defraIdToken}}

{
  "query": "query SearchBusinesses($searchString: String!, $pagination: Pagination!) { businessSearch(searchString: $searchString, searchType: BUSINESS_NAME, pagination: $pagination) { results { sbi name } pageInfo { number size totalPages totalElements } } }",
  "variables": {
    "searchString": "farm",
    "pagination": {
      "perPage": 50,
      "page": 1
    }
  }
}
