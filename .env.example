# The compose.infra.yml together with compose.grants-ui.yml file contains the default settings for the grants-ui application.
# This file contains examples for OPTIONAL alternative settings that can be used
# to override or extend the default settings if required.
# Copy this file to .env and modify the settings as needed.
# Do not commit the .env file to the repository.
LOG_LEVEL=debug
SESSION_COOKIE_PASSWORD=this-is-a-very-long-and-secure-password-for-development-only
SESSION_COOKIE_TTL=2419200000
FEEDBACK_SURVEY_URL="https://defragroup.eu.qualtrics.com/jfe/form/SV_0pL2USQ2uiEKK6G"

# Consolidated View API - used to get DAL data
CV_API_MOCK_ENABLED=false
CV_API_STUB_URL="http://localhost:3008/graphql"
CV_API_ENDPOINT="https://fcp-dal-api.api.test.cdp-int.defra.cloud/graphql"
CV_API_DEVELOPER_KEY=  # API key for live DAL access (local dev only, see docs/CONSOLIDATED-VIEW.md)

# Microsoft Entra auth settings - needed for Consolidated View API's own client-credentials token fetch
# (src/server/common/helpers/entra/token-manager.js). Unrelated to the staff sign-in flow below -
# same Azure app registration as ENTRA_FEDERATED_* below, just using its client secret for this
# service-to-service flow rather than the federated credential. Keep the two configs on separate
# env var names regardless: the credential types aren't interchangeable, and this one is slated to
# migrate to federated credentials later too.
ENTRA_INTERNAL_TOKEN_URL="https://login.microsoftonline.com"
ENTRA_INTERNAL_TENANT_ID=
ENTRA_INTERNAL_CLIENT_ID=
ENTRA_INTERNAL_CLIENT_SECRET=

# Microsoft Entra ID federated staff sign-in (src/server/auth/entraId/). Uses an AWS STS web identity
# token as a client_assertion instead of a client secret - see docs/AUTH-AND-SECURITY.md.
# APP_BASE_URL must be set locally - without it the derived redirect_uri points at
# https://grants-ui.local.cdp-int.defra.cloud, which Azure will reject.
APP_BASE_URL=http://localhost:3000
ENTRA_FEDERATED_TENANT_ID=
ENTRA_FEDERATED_CLIENT_ID=
ENTRA_FEDERATED_AUDIENCE=grants-ui
ENTRA_FEDERATED_ENABLE_MOCKING=true  # Use MockProvider locally instead of a real AWS/Azure federated exchange
ENTRA_FEDERATED_COOKIE_PASSWORD=this-is-a-very-long-and-secure-password-for-development-only
# The following all have working defaults (see src/config/entra-id.js) - only set if overriding:
# ENTRA_FEDERATED_DISCOVERY_URI=       # overrides the URL derived from ENTRA_FEDERATED_TENANT_ID
# ENTRA_FEDERATED_SCOPE=               # default: openid profile email offline_access user.read
# ENTRA_FEDERATED_LOGIN_CALLBACK_URI=  # default: /login/callback
# ENTRA_FEDERATED_USE_HTTP=            # default: false - insecure, local/non-production only
# ENTRA_FEDERATED_EARLY_REFRESH_MS=    # default: 0 - AWS STS token early-refresh window
# ENTRA_FEDERATED_COOKIE_SECURE=       # default: true in production, false otherwise
# ENTRA_FEDERATED_COOKIE_SAME_SITE=    # default: Lax - Strict | Lax | None
# ENTRA_FEDERATED_SESSION_TTL=         # default: 14400000 (4h) - entra-id-session cookie + cache ttl

# Backend API Authentication - use if running a branch of grants-ui-backend locally outside of docker
GRANTS_UI_BACKEND_URL="http://localhost:3001"
GRANTS_UI_BACKEND_AUTH_TOKEN=  # 64-char alphanumeric string (no capitals). Generate: openssl rand -hex 32
GRANTS_UI_BACKEND_ENCRYPTION_KEY=  # 64-char alphanumeric string. Generate: openssl rand -hex 32
GRANTS_UI_BACKEND_AUTH_JWT_SECRET=  # Shared JWT secret with grants-ui-backend for x-encrypted-auth tokens

# GAS API - use if running fg-gas-backend locally outside of docker
GAS_API_URL="http://localhost:3006"
GAS_API_AUTH_TOKEN= # GUID access token minted using the GAS API mint-access-token.js script and stored in GAS MongoDB

# Map data
MAP_MOCK_DATA_ENABLED=false
OS_MAPS_API_KEY=your-key-here
OS_MAPS_BASE_URL="https://api.os.uk/maps/raster/v1/zxy" # override to point the tile proxy at a stub or an egress proxy
MAP_TILE_CACHE_MAX_AGE_SECONDS=3600 # lower to investigate stale tiles

# Defra Id Authentication - use to connect to the `dev` instance of Defra ID
DEFRA_ID_WELL_KNOWN_URL="http://fcp-defra-id-stub:3007/idphub/b2c/b2c_1a_cui_cpdev_signupsigninsfi/.well-known/openid-configuration"
DEFRA_ID_CLIENT_SECRET=  # client secret
DEFRA_ID_CLIENT_ID=  # client ID
DEFRA_ID_SERVICE_ID=  # service ID
DEFRA_ID_REDIRECT_URL="http://localhost:3000/auth/sign-in-oidc"
DEFRA_ID_SIGN_OUT_REDIRECT_URL="http://localhost:3000/auth/sign-out-oidc"

# Single Front Door Config
SFD_UPDATE_ENABLED=true
SFD_UPDATE_URL="http://localhost:3000/sfd/update-sbi"

# FCP Defra ID Stub
AUTH_MODE=  # basic | mock - set to mock to use overrides
AUTH_OVERRIDE=  # simple single crn/org, e.g. crn:firstName:lastName:organisationId:sbi:organisationName
AUTH_OVERRIDE_FILE=  # json file, e.g. test-crns.json - must be mounted at /data/

# Google Analytics / Google Tag Manager
# GA_TRACKING_ID Option for Google Analytics

# Cookie Settings
COOKIE_POLICY_URL=/cookies
COOKIE_CONSENT_EXPIRY_DAYS=365

# Notification banner
# Comma-separated path suffixes on which the per-grant notification banner is never shown.
NOTIFICATION_BANNER_EXCLUDED_PATH_SUFFIXES=/confirmation,/print-submitted-application

# Acceptance Testing
MAX_INSTANCES=1
