{% extends "layouts/page.njk" %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-xl">
      Your draft application has been deleted
    </h1>

    <p class="govuk-body-l">
      A change has been made to the service requiring all draft applications to be removed.
    </p>

    <p class="govuk-body">
      <a
        href="/{{ slug }}/start"
        role="button"
        draggable="false"
        class="govuk-button govuk-button--start"
        data-module="govuk-button">
        Start a new application
        <svg
          class="govuk-button__start-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="17.5"
          height="19"
          viewBox="0 0 33 40"
          aria-hidden="true"
          focusable="false">
          <path
            fill="currentColor"
            d="M0 0h13l20 20-20 20H0l20-20z" />
        </svg>
      </a>
    </p>

  </div>
</div>

{% endblock %}