{% from "govuk/components/input/macro.njk" import govukInput %}

{# describedBy points the input at the availability hint, which lives in the
   checkbox hint above (see select-actions.view-model.js) rather than in this
   panel - govukInput appends its own error message id after it. #}
{{ govukInput({
  id: fieldId,
  name: fieldId,
  classes: "govuk-input--width-5",
  label: {
    text: "Quantity"
  },
  describedBy: (fieldId + "-hint") if maxQuantity != undefined else undefined,
  suffix: {
    text: unit
  } if unit else undefined,
  attributes: {
    max: maxQuantity
  } if maxQuantity != undefined else undefined,
  errorMessage: {
    text: errorText
  } if errorText else undefined,
  value: quantityValue,
  formGroup: {
    beforeInput: {
      html: '<div class="select-actions-refresh-banner select-actions-refresh-banner--hidden" id="' + fieldId + '-refresh-banner">Updating available land for this action&hellip;</div>'
    }
  }
}) }}
