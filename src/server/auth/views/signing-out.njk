{% extends "layouts/page.njk" %}
{% set pageTitle = "Signing you out" %}
{# A transition page: keep it as bare as Defra ID's own sign-out page. #}
{% set hidePhaseBanner = true %}
{% set hideAccountBar = true %}

{% block head %}
  {{ super() }}
  {% if not form %}
    <meta http-equiv="refresh" content="0; url={{ signOutUrl }}" />
  {% endif %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-visually-hidden">Signing you out</h1>
      <p class="govuk-body">
        Please wait while we sign you out. If you are not redirected in 5 seconds click
        <a class="govuk-link" href="{{ signOutUrl }}">here</a>.
      </p>
      {% if form %}
        <form method="post" action="{{ form.endpoint }}" id="defra-id-sign-out">
          {% for name, value in form.fields %}
            <input type="hidden" name="{{ name }}" value="{{ value }}" />
          {% endfor %}
        </form>
      {% endif %}
    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  {% if form %}
    <script nonce="{{ cspNonce }}">
      document.getElementById('defra-id-sign-out').submit()
    </script>
  {% endif %}
{% endblock %}
