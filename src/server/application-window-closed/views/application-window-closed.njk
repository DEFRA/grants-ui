{% extends "layouts/page.njk" %}
{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h2 class="govuk-heading-l">{{ schemeName }}</h2>
      <h1 class="govuk-heading-m">The application window for this grant has closed</h1>

      <p class="govuk-body">
        You can no longer apply for this grant. You can find out about other available funding on GOV.UK.
      </p>

      <p class="govuk-body">
        <a class="govuk-link" href="https://www.gov.uk/find-funding-for-land-or-farms">
          Find funding for farmers, growers and land managers on GOV.UK
        </a>
      </p>
    </div>
  </div>
{% endblock %}
