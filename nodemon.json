{
  "watch": ["./src"],
  "env": {
    "NODE_ENV": "development",
    "AWS_EMF_ENVIRONMENT": "Local"
  },
  "ignore": ["**/*.test.*", "./src/server/common/test-helpers", "./src/client"],
  "ext": "cjs,js,json,html,njk,yaml",
  "signal": "SIGINT",
  "legacyWatch": true,
  "polling": true,
  "pollInterval": 1000
}
