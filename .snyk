# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities
version: v1.25.0
ignore:
  'SNYK-JS-INFLIGHT-6095116':
    - '@defra/forms-engine-plugin > @defra/interactive-map > *':
        reason: 'Rechecked 2026-10-05: forms-engine-plugin@4.23.0 brings interactive-map@0.0.22-alpha > polygon-splitter@0.0.11 > glob@8.1.0 > inflight@1.0.6. No fixed inflight release. The published polygon-splitter runtime does not import glob; its browser bundle does not load inflight. Remove when polygon-splitter drops or updates glob.'
        expires: '2026-10-31'
    - '@defra/interactive-map > polygon-splitter > glob > inflight':
        reason: 'Rechecked 2026-10-05 on interactive-map@0.0.51-apha: polygon-splitter@0.0.11 declares glob@8.1.0 but its published runtime does not import it. No fixed inflight release; inflight is not included in the browser runtime. Remove when polygon-splitter drops or updates glob.'
        expires: '2026-10-31'
  'SNYK-JS-BRACES-19963945':
    - '@defra/forms-engine-plugin > @defra/interactive-map > *':
        reason: 'Rechecked 2026-10-05 on forms-engine-plugin@4.23.0: interactive-map@0.0.22-alpha brings Docusaurus@3.10.2 > chokidar/globby > braces@3.0.3. No fixed braces release. This is the map package documentation build tooling, which grants-ui never runs or bundles for applicants. Remove when braces is fixed or upstream drops these dependencies.'
        expires: '2026-10-31'
  'SNYK-JS-HTTPCACHESEMANTICS-19964064':
    - '@defra/forms-engine-plugin > @defra/interactive-map > *':
        reason: 'Rechecked 2026-10-05 on forms-engine-plugin@4.23.0: Docusaurus@3.10.2 > update-notifier@6.0.2 > got@12.6.1 > cacheable-request@10.2.14 > http-cache-semantics@4.3.0. Snyk reports no fixed release. Only used by the map documentation update notifier, which grants-ui never runs. Remove when fixed or the documentation dependencies are dropped.'
        expires: '2026-10-31'
  'SNYK-JS-HTTPCACHESEMANTICS-19964068':
    - '@defra/forms-engine-plugin > @defra/interactive-map > *':
        reason: 'Rechecked 2026-10-05 on forms-engine-plugin@4.23.0: Docusaurus@3.10.2 > update-notifier@6.0.2 > got@12.6.1 > cacheable-request@10.2.14 > http-cache-semantics@4.3.0. Snyk reports no fixed release. Only used by the map documentation update notifier, which grants-ui never runs. Remove when fixed or the documentation dependencies are dropped.'
        expires: '2026-10-31'
  'SNYK-JS-URIJS-19963961':
    - '@defra/forms-engine-plugin > @defra/interactive-map > *':
        reason: 'Rechecked 2026-10-05 on forms-engine-plugin@4.23.0: Docusaurus@3.10.2 > file-loader@6.2.0 > schema-utils@3.3.0 > ajv@6.15.0 > uri-js@4.4.1. No fixed release. This documentation build chain is never run by grants-ui; Ajv handles static schema identifiers, not applicant input. Remove when fixed or upstream drops the documentation dependencies.'
        expires: '2026-10-31'
  'SNYK-JS-URIJS-19963963':
    - '@defra/forms-engine-plugin > @defra/interactive-map > *':
        reason: 'Rechecked 2026-10-05 on forms-engine-plugin@4.23.0: Docusaurus@3.10.2 > file-loader@6.2.0 > schema-utils@3.3.0 > ajv@6.15.0 > uri-js@4.4.1. No fixed release. This documentation build chain is never run by grants-ui; Ajv handles static schema identifiers, not applicant input. Remove when fixed or upstream drops the documentation dependencies.'
        expires: '2026-10-31'
  'SNYK-JS-SPRINTFJS-20532016':
    - 'global-agent > roarr > sprintf-js':
        reason: 'Checked 2026-10-07: global-agent@3.0.0 > roarr@2.15.4 > sprintf-js@1.1.3. No fixed sprintf-js release; the only fix is global-agent v4 (drops roarr from 4.1.0). global-agent is pinned to 3.0.0 because 4.1.3 broke the OIDC well-known fetch over the CDP egress proxy (#968, #969). Remove when global-agent v4 is re-verified in a CDP environment.'
        expires: '2026-11-06'
  'SNYK-JS-URIJS-20341609':
    - '@defra/forms-engine-plugin > @defra/interactive-map > *':
        reason: 'Rechecked 2026-10-05 on forms-engine-plugin@4.23.0: Docusaurus@3.10.2 > file-loader@6.2.0 > schema-utils@3.3.0 > ajv@6.15.0 > uri-js@4.4.1. No fixed release. This documentation build chain is never run by grants-ui; Ajv handles static schema identifiers, not applicant input. Remove when fixed or upstream drops the documentation dependencies.'
        expires: '2026-10-31'
patch: {}
