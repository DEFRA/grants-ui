# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities
version: v1.25.0
ignore:
  'SNYK-JS-INFLIGHT-6095116':
    - '*':
        reason: 'Not reachable in application runtime — inflight is only present via glob from @defra/interactive-map/polygon-splitter package metadata and dev/build tooling; grants-ui and the shipped map bundles do not import glob or inflight. No upstream fix available; reassess for interactive-map/polygon-splitter dependency removal.'
        expires: '2026-07-30'
  'SNYK-JS-POSTCSSSELECTORPARSER-16873882':
    - '*':
        reason: 'No fix available — build-time only, not exposed at runtime. Monitor for upstream patch.'
        expires: '2026-08-01'
  'SNYK-JS-IMAGESIZE-17295814':
    - '*':
        reason: 'Build-time only — vulnerable path is docusaurus mdx-loader in @defra/interactive-map docs, never loaded by grants-ui runtime. No upstream fix available.'
        expires: '2026-08-01'
  'SNYK-JS-IMAGESIZE-17295816':
    - '*':
        reason: 'Build-time only — vulnerable path is docusaurus mdx-loader in @defra/interactive-map docs, never loaded by grants-ui runtime. No upstream fix available.'
        expires: '2026-08-01'
  'SNYK-JS-WEBPACKDEVSERVER-17812733':
    - '*':
        reason: 'Build-time only — webpack-dev-server via the docusaurus toolchain in @defra/interactive-map docs, never loaded by grants-ui runtime. Fixed in 5.2.6; interim ignore while the override is blocked by .npmrc min-release-age=7 (5.2.6 published 2026-07-02, installable from 2026-07-09). Replace with an overrides pin and remove this entry once it clears the cooldown.'
        expires: '2026-07-16'
  'SNYK-JS-WEBPACKDEVSERVER-17812743':
    - '*':
        reason: 'Build-time only — webpack-dev-server via the docusaurus toolchain in @defra/interactive-map docs, never loaded by grants-ui runtime. Fixed in 5.2.6; interim ignore while the override is blocked by .npmrc min-release-age=7 (5.2.6 published 2026-07-02, installable from 2026-07-09). Replace with an overrides pin and remove this entry once it clears the cooldown.'
        expires: '2026-07-16'
  'SNYK-JS-JSYAML-17342520':
    - '*':
        reason: 'Build-time only — remaining vulnerable copy is js-yaml@3.15.0 under gray-matter via the docusaurus mdx-loader toolchain in @defra/interactive-map docs, never loaded by grants-ui runtime. Fix exists only in the 4.x line (4.2.0+; 4.x copies already pinned to 4.3.0 via overrides) and gray-matter cannot take js-yaml 4.x — it calls the removed safeLoad API. Remove once @defra/interactive-map drops the docusaurus toolchain from its runtime dependencies or gray-matter supports js-yaml 4.'
        expires: '2026-08-13'
  'SNYK-JS-HTTPPROXYMIDDLEWARE-17375053':
    - '*':
        reason: 'Build-time only — http-proxy-middleware via webpack-dev-server in the docusaurus toolchain of @defra/interactive-map docs, never loaded by grants-ui runtime. Fixed only in 3.0.6/4.1.0, but webpack-dev-server@5.2.5 pins http-proxy-middleware ^2.0.9, so no in-range upgrade or override is viable. Remove once webpack-dev-server bumps to an http-proxy-middleware 3.x/4.x line.'
        expires: '2026-07-16'
  'SNYK-JS-SHELLQUOTE-17457810':
    - '*':
        reason: 'Build-time only — shell-quote via npm-run-all and webpack-dev-server/launch-editor in the dev toolchain, never loaded by grants-ui runtime. Fixed in 1.9.0; interim ignore while the override is blocked by .npmrc min-release-age=7 (1.9.0 published 2026-06-25, installable from 2026-07-02). Replace with an overrides pin and remove this entry once it clears the cooldown.'
        expires: '2026-07-09'
  'SNYK-JS-BODYPARSER-17906397':
    - '*':
        reason: 'Build-time only — body-parser via express@4 in webpack-dev-server (webpack-cli dev toolchain), never loaded by grants-ui runtime. Fixed in 1.20.6; interim ignore while the override is blocked by .npmrc min-release-age=7 (1.20.6 published 2026-07-09, installable from 2026-07-16). Replace with an overrides pin to body-parser@1.20.6 and remove this entry once it clears the cooldown.'
        expires: '2026-07-23'
  'SNYK-JS-BRACEEXPANSION-17706650':
    - '*':
        reason: 'Fix version is incoming from Defra forms team - Inefficient Algorithmic Complexity [High Severity][https://security.snyk.io/vuln/SNYK-JS-BRACEEXPANSION-17706650]'
        expires: '2026-07-30'
  'SNYK-JS-WS-17988732':
